generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  USER
  ADMIN
}

enum ToyStatus {
  DRAFT
  READY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum MatchStatus {
  MATCHED
  PRODUCTION
  SHIPPED
  DELIVERED
  RECEIVED
  COMPLETED
  CANCELLED
}

model User {
  id            String              @id
  name          String
  email         String              @unique
  emailVerified Boolean             @default(false)
  image         String?
  role          Role                @default(USER)
  suspended     Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  accounts      Account[]
  sessions      Session[]
  toys          Toy[]
  payments      Payment[]
  entries       ExchangePoolEntry[]
  sent          Match[]             @relation("sender")
  received      Match[]             @relation("recipient")
  collection    CollectionEntry[]
  notifications Notification[]
  audits        AdminAuditLog[]
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Toy {
  id        String             @id @default(cuid())
  publicId  String?            @unique
  creatorId String
  creator   User               @relation(fields: [creatorId], references: [id])
  name      String
  status    ToyStatus          @default(DRAFT)
  edition   Int                @default(1)
  moderated Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  design    ToyDesign?
  assets    ToyAsset[]
  secret    SecretMessage?
  payment   Payment?
  entry     ExchangePoolEntry?
  match     Match?
}

model ToyDesign {
  id      String @id @default(cuid())
  toyId   String @unique
  toy     Toy    @relation(fields: [toyId], references: [id], onDelete: Cascade)
  config  Json
  version Int    @default(1)
}

model ToyAsset {
  id    String @id @default(cuid())
  toyId String
  toy   Toy    @relation(fields: [toyId], references: [id], onDelete: Cascade)
  kind  String
  url   String @db.LongText
}

model SecretMessage {
  id    String @id @default(cuid())
  toyId String @unique
  toy   Toy    @relation(fields: [toyId], references: [id], onDelete: Cascade)
  text  String @db.Text
}

model Payment {
  id        String        @id @default(cuid())
  toyId     String        @unique
  toy       Toy           @relation(fields: [toyId], references: [id])
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  amount    Int
  status    PaymentStatus @default(PENDING)
  history   Json
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ExchangePoolEntry {
  id           String    @id @default(cuid())
  toyId        String    @unique
  toy          Toy       @relation(fields: [toyId], references: [id])
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  activeUserId String?   @unique
  status       String    @default("WAITING")
  createdAt    DateTime  @default(now())
  matchedAt    DateTime?

  @@index([status, createdAt])
}

model Exchange {
  id          String    @id @default(cuid())
  requestKey  String    @unique
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  matches     Match[]
}

model Match {
  id          String           @id @default(cuid())
  exchangeId  String
  exchange    Exchange         @relation(fields: [exchangeId], references: [id])
  toyId       String           @unique
  toy         Toy              @relation(fields: [toyId], references: [id])
  senderId    String
  sender      User             @relation("sender", fields: [senderId], references: [id])
  recipientId String
  recipient   User             @relation("recipient", fields: [recipientId], references: [id])
  status      MatchStatus      @default(MATCHED)
  history     Json
  createdAt   DateTime         @default(now())
  receivedAt  DateTime?
  shipment    Shipment?
  collection  CollectionEntry?

  @@unique([exchangeId, recipientId])
  @@unique([exchangeId, senderId])
}

model Shipment {
  id           String   @id @default(cuid())
  matchId      String   @unique
  match        Match    @relation(fields: [matchId], references: [id])
  destination  String   @default("Oujda, Morocco (simulated)")
  trackingCode String   @unique
  updatedAt    DateTime @updatedAt
}

model CollectionEntry {
  id         String   @id @default(cuid())
  matchId    String   @unique
  match      Match    @relation(fields: [matchId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  revealedAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  message   String
  relatedId String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  entityId  String
  details   Json
  createdAt DateTime @default(now())
}

// Every write affecting pool eligibility takes this same row lock.
model OperationLock {
  id String @id
}
